# Скопируйте в .env и поправьте под себя.
# Обязательный параметр — POSTGRES_PASSWORD.

# --- База данных ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=password_manager

# --- Порт, на котором приложение станет доступно снаружи ---
FRONTEND_PORT=8080

# --- Backend ---
ENVIRONMENT=production
DEBUG=false
DOCS_ENABLED=false
# origin'ы фронтенда через запятую (обычно не нужны: /api идёт через тот же origin)
CORS_ORIGINS=http://localhost:8080
# Пусто = счётчики rate limit в памяти (ок для одного воркера)
RATE_LIMIT_STORAGE_URI=
