# Приложение
ENVIRONMENT=dev
DEBUG=true
DOCS_ENABLED=true          # в production обязательно false

# CORS: точный список origin'ов фронтенда через запятую.
# В production: https://vault.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limits
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_WRITE=30/minute
RATE_LIMIT_AUTH=5/minute
# Пусто = хранение счётчиков в памяти процесса (только dev!).
# В prod (несколько воркеров): redis://redis:6379/0
RATE_LIMIT_STORAGE_URI=

# Максимальный размер тела запроса (байт) — 3 MB
MAX_REQUEST_BODY_BYTES=3145728
